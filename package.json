{
  "name": "lisandra-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify Horizon theme untuk Lisandra The Label",
  "scripts": {
    "dev": "shopify theme dev --store lisandrathelabel.com",
    "check": "shopify theme check",
    "pull:live": "shopify theme pull --store lisandrathelabel.com --live",
